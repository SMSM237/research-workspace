<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="8dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:layout_marginBottom="8dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:padding="2dp" android:background="@drawable/tab_container">
   <TextView android:id="@+id/tab_tasks" android:includeFontPadding="false" android:maxLines="1" android:layout_width="54dp" android:layout_height="match_parent" android:gravity="center" android:text="할 일" android:textSize="14sp" android:textStyle="bold" android:textColor="#20372D"/>
   <TextView android:id="@+id/tab_meetings" android:includeFontPadding="false" android:maxLines="1" android:layout_width="54dp" android:layout_height="match_parent" android:gravity="center" android:text="회의" android:textSize="14sp" android:textStyle="bold" android:textColor="#63736A"/>
  </LinearLayout>
  <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:layout_marginHorizontal="8dp" android:background="@drawable/wave_track" android:clipToOutline="true" android:importantForAccessibility="no">
   <ImageView android:id="@+id/progress_wave" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<FrameLayout android:id="@+id/wave_overlay" android:layout_width="0dp" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no"/>
  </FrameLayout>
  <TextView android:id="@+id/widget_count" android:includeFontPadding="false" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="end|center_vertical" android:textSize="20sp" android:textStyle="bold" android:textColor="#20372D" android:fontFeatureSettings="tnum" android:paddingEnd="4dp"/>
  <ImageView android:id="@+id/git_dot" android:layout_width="32dp" android:layout_height="match_parent" android:padding="8dp" android:background="@drawable/widget_press" android:contentDescription="Git 연결 상태"/>
 </LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/task_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="none"/>
  <TextView android:id="@+id/task_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="13sp" android:textColor="#63736A" android:padding="3dp"/>
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical"><ImageView android:id="@+id/add_task" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="0dp" android:background="@drawable/control_surface" android:scaleType="fitCenter"/><ImageView android:id="@+id/open_meeting" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/control_surface" android:scaleType="fitCenter"/><FrameLayout android:id="@+id/start_analysis" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/control_purple"><ImageView android:id="@+id/start_analysis_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/><ProgressBar android:id="@+id/start_analysis_orbit" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/motion_analyze_orbit" android:indeterminateTint="@null" android:visibility="gone" android:importantForAccessibility="no"/><ProgressBar android:id="@+id/start_analysis_wait" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/motion_analyze_wait" android:indeterminateTint="@null" android:visibility="gone" android:importantForAccessibility="no"/><ProgressBar android:id="@+id/start_analysis_sent" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/motion_analyze_sent" android:indeterminateTint="@null" android:visibility="gone" android:importantForAccessibility="no"/></FrameLayout><FrameLayout android:id="@+id/git_sync" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/control_green"><ImageView android:id="@+id/git_sync_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/><ProgressBar android:id="@+id/git_sync_orbit" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/motion_sync_orbit" android:indeterminateTint="@null" android:visibility="gone" android:importantForAccessibility="no"/><ProgressBar android:id="@+id/git_sync_wait" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/motion_sync_wait" android:indeterminateTint="@null" android:visibility="gone" android:importantForAccessibility="no"/><ProgressBar android:id="@+id/git_sync_sent" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/motion_sync_sent" android:indeterminateTint="@null" android:visibility="gone" android:importantForAccessibility="no"/></FrameLayout></LinearLayout>
</LinearLayout>